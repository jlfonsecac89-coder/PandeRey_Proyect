# Ver BLUEPRINT.md sección 18 para el detalle de cada variable.
# Copiar este archivo a .env.local y completar con los valores reales.
# .env.local nunca se commitea (ver .gitignore).

# Sitio (usado en links de callback de auth/OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Cifrado de campos sensibles (RUT, tokens de integraciones)
FIELD_ENCRYPTION_KEY=

# Email
RESEND_API_KEY=

# Rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Programa de puntos
LOYALTY_POINTS_PER_CLP=0.001
LOYALTY_POINTS_TO_CLP_RATE=10

# Geocodificación y rutas (delivery)
GOOGLE_MAPS_API_KEY=

# Pipeline de pedidos (SLA)
ORDER_PREP_SLA_MINUTES=30
MAX_DELIVERY_ISSUE_WAIT_MINUTES=10

# Inventario y analítica
CLEARANCE_ALERT_DAYS_BEFORE_EXPIRY=3
RFM_ANALYSIS_WINDOW_DAYS=365

# Instagram (landing)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Proveedor DTE (SII) — nombres exactos dependen del proveedor elegido (ver BLUEPRINT.md sección 20)
DTE_PROVIDER_API_KEY=

# WhatsApp Business API (solo transferencia bancaria)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
BANK_TRANSFER_PROOF_TIMEOUT_HOURS=48

# Observabilidad
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
