# .claudeignore
node_modules/
.next/
dist/
build/
out/
coverage/
.vercel/

# Lockfiles (Bloqueados para ahorrar miles de tokens)
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lockb

# Logs y temporales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variables de entorno (Seguridad)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
